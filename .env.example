# Sendrift - Example Environment Configuration
# Copy this file to .env for local development. Never commit real credentials to version control.

# Application Environment (development | production | test)
APP_ENV=development
LOG_LEVEL=INFO

# FastAPI Backend
API_HOST=0.0.0.0
API_PORT=8000
# JSON list of allowed origins for CORS. In production, specify exact origin(s).
CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL
POSTGRES_USER=sendrift_user
POSTGRES_PASSWORD=sendrift_local_password_only
POSTGRES_DB=sendrift
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sendrift_user:sendrift_local_password_only@postgres:5432/sendrift
# Sync URL used by Alembic migrations
DATABASE_SYNC_URL=postgresql://sendrift_user:sendrift_local_password_only@postgres:5432/sendrift

# MinIO / S3 Object Storage (Private bucket)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=sendrift_local_minio_access
S3_SECRET_KEY=sendrift_local_minio_secret_key
S3_BUCKET_NAME=sendrift-files
S3_REGION=us-east-1

# Upload limits (MVP: 100 MiB = 104857600 bytes)
MAX_FILE_SIZE_BYTES=104857600

# Next.js Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
PORT=3000
