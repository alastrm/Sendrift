# Example Nginx reverse proxy configuration for Sendrift
# Enforces body limits, hides storage and database from public network,
# and routes traffic to Next.js web UI and FastAPI backend on the same origin.

events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile        on;
    keepalive_timeout 65;

    # Allow maximum 105 MiB payload (100 MiB file limit + multipart boundary overhead)
    client_max_body_size 105M;

    # Redact share tokens from request URI in access logs
    # Matches /s/<share_token> and /api/v1/shares/<share_token>(/download)
    # Preserves path structure and operational logging while masking sensitive tokens
    map $request_uri $redacted_request_uri {
        ~*^(/s/)[^/?#]+(.*)$                                              $1[REDACTED]$2;
        ~*^(/api/v1/shares/)[^/?#]+(/[^?#]+)?([?#].*)?$                   $1[REDACTED]$2$3;
        default                                                           $request_uri;
    }

    # Redact share tokens from Referer header if present
    map $http_referer $redacted_referer {
        ~*^(https?://[^/]+/s/|/s/)[^/?#]+(.*)$                            $1[REDACTED]$2;
        ~*^(https?://[^/]+/api/v1/shares/|/api/v1/shares/)[^/?#]+(/[^?#]+)?([?#].*)?$ $1[REDACTED]$2$3;
        default                                                           $http_referer;
    }

    # Custom access log format: logs redacted URI and redacted Referer.
    # Management secrets (X-Manage-Token) and presigned tokens are never logged.
    log_format redacted_combined '$remote_addr - $remote_user [$time_local] '
                                 '"$request_method $redacted_request_uri $server_protocol" '
                                 '$status $body_bytes_sent "$redacted_referer" '
                                 '"$http_user_agent"';

    access_log /var/log/nginx/access.log redacted_combined;

    upstream web_upstream {
        server web:3000;
    }

    upstream api_upstream {
        server api:8000;
    }

    server {
        listen 80;
        server_name localhost;

        # API routing
        location /api/ {
            proxy_pass http://api_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
        }

        # Health endpoints
        location /health/ {
            proxy_pass http://api_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # Frontend routing
        location / {
            proxy_pass http://web_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
